RAGS_ENV=development
RAGS_API_KEY=local-development-key
RAGS_DB_PATH=./data/rags.db
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=extractive
# Set both to use semantic embeddings and OpenAI-compatible generation:
# RAGS_EMBEDDING_PROVIDER=openai
# RAGS_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# RAGS_MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
# Production: use the generated-credential bootstrap linked from README.md.
# It writes ignored data/production.env for both sibling repositories.
# RAGS_ENV=production
# RAGS_KEYS_JSON maps the generated RAG token to tenant-a.
# Agent uses the reverse map: AGENT_RAG_KEYS_JSON maps tenant-a to that token.
# Requester and approver tokens are separate and belong only to Agent.
# Generate at least 32 random bytes per token; do not reuse development keys.

# Explicit source chunking and exact model tokenizer (JSON strings).
# RAGS_TOKENIZER_JSON={"backend":"tiktoken","encoding":"cl100k_base"}
# RAGS_CHUNKING_JSON={"strategy":"recursive","max_tokens":256,"overlap_tokens":32}
# Generation counts use a separate tokenizer from ingestion.
# RAGS_GENERATION_TOKENIZER_JSON={"backend":"tiktoken","encoding":"cl100k_base"}
# RAGS_CONTEXT_BUDGET=8192
# RAGS_OUTPUT_BUDGET=1024
# RAGS_ENVELOPE_BUDGET=128

# Install .[encoders,vision] before enabling real local ONNX models.
# RAGS_EMBEDDING_PROVIDER=fastembed
# RAGS_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# RAGS_MODEL_CACHE=./data/models
# RAGS_LATE_INTERACTION_MODEL=answerdotai/answerai-colbert-small-v1
# RAGS_MULTIMODAL_MODEL=clip-vit-b-32

# Admission is explicitly unassessed without an operator-selected profile.
RAGS_ADMISSION_POLICY=compatibility
# RAGS_ADMISSION_POLICY=calibrated_required
# RAGS_ADMISSION_PROFILE=/absolute/path/to/reviewed-profile.json
# Read the measured quality report before choosing a profile.

# Named upstream backends require their actual implementation and tenant keys.
# An HTTP adapter configuration alone is not verification of that paper's method.
# RAGS_RESEARCH_BACKENDS_JSON={"lightrag":{"url":"https://your-backend.example/retrieve","tenant_tokens":{"tenant-id":"replace-credential"},"timeout_seconds":150,"require_pinned_upstream":true}}
# Sidecar process only: install its isolated dependencies first.
# RAGS_RESEARCH_ENGINE=lightrag
# RAGS_RESEARCH_KEYS_JSON={"replace-with-strong-secret":"tenant-id"}
# RAGS_RESEARCH_TIMEOUT_SECONDS=120
# RAGS_RESEARCH_CONCURRENCY=1
# RAGS_RESEARCH_WORK_DIR=/absolute/path/to/private-temp-root
# RAGS_RAPTOR_SOURCE=/absolute/path/to/pinned/raptor
