# Offline, SQLite and deterministic hashing; no remote model calls.
RAGS_ENV=development
RAGS_DB_PATH=__DB_PATH__
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=extractive
RAGS_FEATURES_FILE=__FEATURES_PATH__

# Optional self-hosted admin on explicit local-development HTTP.
# Never use this insecure mode in production; deploy behind HTTPS.
RAGS_ADMIN_ENABLED=false
RAGS_ADMIN_DEV_HTTP=false

# OTel is disabled by default; configure a Collector for OTLP/HTTP JSON export.
RAGS_OTEL_ENABLED=false

# Agent/model router/memory are disabled by default.
# Explicitly enable only the workloads you authorize and configure any needed Gateway.
RAGS_AGENT_ENABLED=false
RAGS_ROUTER_ENABLED=false
RAGS_MEMORY_ENABLED=false
