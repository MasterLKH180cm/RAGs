# Native host PostgreSQL; precreate vector extension and edit the DSN.
# Docker Compose uses its own bootstrap and container-hostname DSN instead.
RAGS_ENV=production
RAGS_DATABASE_URL=postgresql://rags_app:REPLACE_ME@127.0.0.1:5432/rags
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=extractive
RAGS_FEATURES_FILE=__FEATURES_PATH__
