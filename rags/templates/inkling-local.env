# Self-hosted Inkling: start a compatible model server separately on this host.
# This profile performs no download and does not establish model/hardware readiness.
RAGS_ENV=development
RAGS_DB_PATH=__DB_PATH__
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=openai
RAGS_GENERATION_BASE_URL=http://127.0.0.1:8080/v1
RAGS_GENERATION_MODEL=thinkingmachines/Inkling-2-Mini
RAGS_GENERATION_AUTH_MODE=none
RAGS_GENERATION_PROTOCOL=openai
RAGS_REASONING_EFFORT=
RAGS_GENERATION_TOKENIZER_JSON='{"backend":"utf8_bytes"}'
RAGS_CONTEXT_BUDGET=4096
RAGS_OUTPUT_BUDGET=1024
RAGS_ROUTER_GATEWAY_URL=http://127.0.0.1:8080/v1
RAGS_ROUTER_AUTH_MODE=none
RAGS_ROUTER_ALLOW_HTTP=true
RAGS_ROUTER_MODELS_JSON='{"inkling":"thinkingmachines/Inkling-2-Mini"}'
RAGS_ROUTER_MODEL_OPTIONS_JSON='{"inkling":{"protocol":"openai"}}'
RAGS_FEATURES_FILE=__FEATURES_PATH__
