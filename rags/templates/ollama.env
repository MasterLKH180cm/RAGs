# OpenAI-compatible local Ollama; pull matching models in Ollama separately.
RAGS_ENV=development
RAGS_DB_PATH=__DB_PATH__
RAGS_EMBEDDING_PROVIDER=openai
RAGS_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAGS_EMBEDDING_MODEL=nomic-embed-text
RAGS_EMBEDDING_API_KEY=ollama
RAGS_MODEL_PROVIDER=openai
RAGS_GENERATION_BASE_URL=http://127.0.0.1:11434/v1
RAGS_GENERATION_MODEL=llama3.2
RAGS_GENERATION_API_KEY=ollama
RAGS_GENERATION_TOKENIZER_JSON='{"backend":"unicode"}'
RAGS_FEATURES_FILE=__FEATURES_PATH__
