# Local hashing embeddings + Anthropic chat; set ANTHROPIC_API_KEY in process env.
RAGS_ENV=development
RAGS_DB_PATH=data/rags.db
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=anthropic
RAGS_GENERATION_BASE_URL=https://api.anthropic.com/v1
RAGS_GENERATION_MODEL=claude-sonnet-4-5
RAGS_FEATURES_FILE=__FEATURES_PATH__
