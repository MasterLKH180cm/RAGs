# Shared LiteLLM generation. Configure all gateway fields together before use.
# Full-stack deployment: agentic-system/compose.litellm.yaml and docs/LITELLM.md.
RAGS_ENV=production
RAGS_DB_PATH=__DB_PATH__
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=router
RAGS_GENERATION_MODEL=inkling
RAGS_GENERATION_TOKENIZER_JSON='{"backend":"utf8_bytes"}'
RAGS_CONTEXT_BUDGET=4096
RAGS_OUTPUT_BUDGET=1024
RAGS_ROUTER_ENABLED=true
RAGS_ROUTER_AUTH_MODE=required
RAGS_ROUTER_GATEWAY_URL=
RAGS_ROUTER_API_KEY_FILE=
RAGS_ROUTER_CA_FILE=
RAGS_ROUTER_ALLOW_HTTP=false
RAGS_ROUTER_MODELS_JSON={}
# When ready, set MODELS_JSON to {"inkling":"gateway/inkling-2-mini-iq4nl-v1"}.
RAGS_ROUTER_MODEL_OPTIONS_JSON={}
# Set OPTIONS_JSON to {"inkling":{"protocol":"openai"}} with the approved mapping.
RAGS_FEATURES_FILE=__FEATURES_PATH__
