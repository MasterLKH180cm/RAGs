# OpenAI-compatible text embeddings and chat; set credentials securely in process env.
RAGS_ENV=development
RAGS_DB_PATH=data/rags.db
RAGS_EMBEDDING_PROVIDER=openai
RAGS_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAGS_EMBEDDING_MODEL=text-embedding-3-small
RAGS_MODEL_PROVIDER=openai
RAGS_GENERATION_BASE_URL=https://api.openai.com/v1
RAGS_GENERATION_MODEL=gpt-4.1-mini
RAGS_FEATURES_FILE=__FEATURES_PATH__
