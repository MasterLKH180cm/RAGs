# Inkling 2 Mini generation through the official Tinker compatible API.
# Supply RAGS_GENERATION_API_KEY or RAGS_GENERATION_API_KEY_FILE securely.
# Ambient OPENAI_API_KEY and TINKER_API_KEY are not used by this generation profile.
# Source embeddings remain the explicitly labelled offline demo hash encoder.
RAGS_ENV=development
RAGS_DB_PATH=__DB_PATH__
RAGS_EMBEDDING_PROVIDER=local
RAGS_MODEL_PROVIDER=openai
RAGS_GENERATION_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
RAGS_GENERATION_MODEL=thinkingmachines/Inkling-2-Mini
RAGS_GENERATION_PROTOCOL=tinker
RAGS_REASONING_EFFORT=low
RAGS_GENERATION_TOKENIZER_JSON='{"backend":"utf8_bytes"}'
RAGS_OUTPUT_BUDGET=1024
RAGS_FEATURES_FILE=__FEATURES_PATH__
